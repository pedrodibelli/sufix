{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push *)",

      "Bash(vercel ls *)",
      "Bash(vercel inspect *)",
      "Bash(vercel logs *)",
      "Bash(vercel whoami)",
      "Bash(vercel project inspect *)",
      "Bash(vercel domains inspect *)",
      "Bash(vercel domains ls *)",

      "Bash(npx vercel ls *)",
      "Bash(npx vercel inspect *)",
      "Bash(npx vercel logs *)",
      "Bash(npx vercel whoami)",
      "Bash(npx vercel project inspect *)",
      "Bash(npx vercel domains inspect *)",
      "Bash(npx vercel domains ls *)"
    ]
  }
}
